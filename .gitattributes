# Normalize line endings: keep LF in the repo, avoid CRLF churn on Windows.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.ics text eol=lf

# Lockfiles: keep exactly as the package manager writes them
package-lock.json -diff