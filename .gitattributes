# Normalize line endings: keep LF in the repo, avoid CRLF churn on Windows.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.ics text eol=lf

# Lockfile: generated artifact, keep LF, hide from diffs but stay text
package-lock.json text eol=lf linguist-generated=true -diff